<ModelagemCompScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: 0.95, 0.95, 0.97, 1

        MDTopAppBar:
            title: "8. Modelagem Computacional"
            elevation: 2
            left_action_items: [["arrow-left", lambda x: root.voltar()]]

        ScrollView:
            MDBoxLayout:
                orientation: 'vertical'
                padding: "16dp"
                spacing: "24dp"
                adaptive_height: True

                # ==========================================
                # BLOCO 1: FUNDAMENTOS TEÓRICOS
                # ==========================================
                MDCard:
                    orientation: 'vertical'
                    padding: "20dp"
                    spacing: "12dp"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [15]
                    md_bg_color: 1, 1, 1, 1
                    elevation: 2

                    MDLabel:
                        text: "Simulação de Sistemas Reais"
                        font_style: "H6"
                        bold: True
                        theme_text_color: "Primary"
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        text: "A modelagem computacional recria o mundo real dentro do computador. Em um financiamento de veículo, o banco utiliza o Sistema Price. Os juros compostos são aplicados apenas sobre o Valor Financiado (Preço do Carro menos a sua Entrada)."
                        font_style: "Body2"
                        theme_text_color: "Secondary"
                        size_hint_y: None
                        height: self.texture_size[1]

                # ==========================================
                # O TUTOR IA (ANIMAÇÃO)
                # ==========================================
                MDBoxLayout:
                    id: balao_robo
                    opacity: 0
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "12dp"

                    MDIcon:
                        icon: "robot-excited-outline"
                        font_size: "54sp"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        pos_hint: {"top": 1}

                    MDCard:
                        id: card_fala
                        orientation: 'vertical'
                        md_bg_color: 0.85, 0.92, 0.98, 1
                        radius: [0, 20, 20, 20]
                        padding: "16dp"
                        spacing: "8dp"
                        size_hint_y: None
                        height: self.minimum_height
                        elevation: 1

                        MDLabel:
                            text: "Concessionária Virtual!"
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Primary"
                            size_hint_y: None
                            height: self.texture_size[1]
                            
                        MDLabel:
                            text: "O maior erro financeiro é olhar apenas para o valor da parcela. Ajuste o tamanho da sua Entrada no painel abaixo e descubra o verdadeiro preço final do veículo!"
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                # ==========================================
                # BLOCO 2: DASHBOARD DE FINANCIAMENTO
                # ==========================================
                MDCard:
                    orientation: 'vertical'
                    padding: "20dp"
                    spacing: "16dp"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [15]
                    md_bg_color: 0.15, 0.15, 0.2, 1 

                    MDLabel:
                        text: "CONTRATO DO BANCO"
                        font_style: "Overline"
                        theme_text_color: "Custom"
                        text_color: 0.7, 0.7, 0.7, 1
                        halign: "center"
                        size_hint_y: None
                        height: self.texture_size[1]
                        
                    MDBoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: self.minimum_height
                        MDLabel:
                            text: "Valor Financiado:"
                            font_style: "Subtitle2"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            size_hint_y: None
                            height: self.texture_size[1]
                        MDLabel:
                            text: f"R$ {root.valor_financiado_calc:.2f}"
                            font_style: "Body1"
                            theme_text_color: "Custom"
                            text_color: 0.8, 0.8, 0.8, 1 
                            halign: "right"
                            size_hint_y: None
                            height: self.texture_size[1]
                            
                    MDBoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: self.minimum_height
                        MDLabel:
                            text: "Juros Cobrados:"
                            font_style: "Subtitle2"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            size_hint_y: None
                            height: self.texture_size[1]
                        MDLabel:
                            text: f"+ R$ {root.total_juros_calc:.2f}"
                            font_style: "Body1"
                            theme_text_color: "Custom"
                            text_color: 0.9, 0.3, 0.3, 1 # Vermelho
                            halign: "right"
                            size_hint_y: None
                            height: self.texture_size[1]

                    MDSeparator:
                        color: 0.4, 0.4, 0.4, 1

                    MDBoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: self.minimum_height
                        MDLabel:
                            text: "CUSTO FINAL DO CARRO:"
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            size_hint_y: None
                            height: self.texture_size[1]
                        MDLabel:
                            text: f"R$ {root.custo_final_calc:.2f}"
                            font_style: "H6"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.9, 0.7, 0.2, 1 # Laranja/Dourado
                            halign: "right"
                            size_hint_y: None
                            height: self.texture_size[1]

                # ==========================================
                # OS SLIDERS INTERATIVOS 
                # ==========================================
                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "60dp"
                    MDLabel:
                        text: f"Preço de Tabela do Veículo: R$ {root.preco_veiculo_val:.2f}"
                        font_style: "Caption"
                        bold: True
                    MDSlider:
                        min: 10000
                        max: 100000
                        step: 5000
                        value: root.preco_veiculo_val
                        on_value: root.atualizar_preco(self.value)

                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "60dp"
                    MDLabel:
                        text: f"Valor da Entrada: {root.perc_entrada_val}% (R$ {root.valor_entrada_calc:.2f})"
                        font_style: "Caption"
                        bold: True
                    MDSlider:
                        min: 0
                        max: 80
                        step: 10
                        value: root.perc_entrada_val
                        on_value: root.atualizar_entrada(self.value)

                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "60dp"
                    MDLabel:
                        text: f"Taxa de Juros do Banco: {root.taxa_val}% ao mês"
                        font_style: "Caption"
                        bold: True
                    MDSlider:
                        min: 1
                        max: 5
                        step: 1
                        value: root.taxa_val
                        on_value: root.atualizar_taxa(self.value)
                        
                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "60dp"
                    MDLabel:
                        text: f"Prazo (Meses): {root.tempo_val}x"
                        font_style: "Caption"
                        bold: True
                    MDSlider:
                        min: 12
                        max: 72
                        step: 12
                        value: root.tempo_val
                        on_value: root.atualizar_tempo(self.value)

                # ==========================================
                # BLOCO 3: MISSÃO E OLIMPÍADA
                # ==========================================
                MDCard:
                    orientation: 'vertical'
                    padding: "16dp"
                    spacing: "16dp"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [10]
                    md_bg_color: 1, 0.95, 0.8, 1 

                    MDLabel:
                        text: root.titulo_missao
                        font_style: "Subtitle2"
                        bold: True
                        theme_text_color: "Error"

                    MDLabel:
                        text: root.texto_missao
                        markup: True
                        font_style: "Caption"
                        theme_text_color: "Primary"
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None

                    MDBoxLayout:
                        id: action_container
                        orientation: 'vertical'
                        spacing: "8dp"
                        size_hint_y: None
                        height: self.minimum_height