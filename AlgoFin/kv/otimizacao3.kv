<Otimizacao3Screen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: 0.95, 0.95, 0.97, 1

        MDTopAppBar:
            title: "10. Projeto de Otimização"
            elevation: 2
            left_action_items: [["arrow-left", lambda x: root.voltar()]]

        ScrollView:
            MDBoxLayout:
                orientation: 'vertical'
                padding: "16dp"
                spacing: "24dp"
                adaptive_height: True

                # ==========================================
                # BLOCO 1: FUNDAMENTOS TEÓRICOS
                # ==========================================
                MDCard:
                    orientation: 'vertical'
                    padding: "20dp"
                    spacing: "12dp"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [15]
                    md_bg_color: 1, 1, 1, 1
                    elevation: 2

                    MDLabel:
                        text: "Otimização de Portfólio"
                        font_style: "H6"
                        bold: True
                        theme_text_color: "Primary"
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        text: "Em computação, otimizar significa encontrar a melhor solução possível dadas as restrições. Nas finanças (Teoria de Markowitz), otimizar uma carteira é encontrar a divisão exata de dinheiro que MAXIMIZA o Retorno e MINIMIZA o Risco simultaneamente."
                        font_style: "Body2"
                        theme_text_color: "Secondary"
                        size_hint_y: None
                        height: self.texture_size[1]

                # ==========================================
                # O TUTOR IA (O GRANDE FINAL)
                # ==========================================
                MDBoxLayout:
                    id: balao_robo
                    opacity: 0
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "12dp"

                    MDIcon:
                        icon: "rocket-launch-outline"
                        font_size: "54sp"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        pos_hint: {"top": 1}

                    MDCard:
                        id: card_fala
                        orientation: 'vertical'
                        md_bg_color: 0.85, 0.92, 0.98, 1
                        radius: [0, 20, 20, 20]
                        padding: "16dp"
                        spacing: "8dp"
                        size_hint_y: None
                        height: self.minimum_height
                        elevation: 1

                        MDLabel:
                            text: "O Desafio do Gestor!"
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Primary"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDLabel:
                            text: "Sua carteira tem R$ 10.000,00. A Renda Fixa te paga 10% com segurança. A Renda Variável te paga 25%, mas aumenta seu risco. Encontre o ponto de equilíbrio perfeito para bater a meta das missões abaixo!"
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                # ==========================================
                # DASHBOARD DO GESTOR
                # ==========================================
                MDCard:
                    orientation: 'vertical'
                    padding: "20dp"
                    spacing: "16dp"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [15]
                    md_bg_color: 0.15, 0.15, 0.2, 1 

                    MDLabel:
                        text: "ALOCAÇÃO DE ATIVOS (R$ 10.000)"
                        font_style: "Overline"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: 0.4, 0.8, 1, 1 
                        halign: "center"
                        size_hint_y: None
                        height: self.texture_size[1]
                        
                    MDBoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: self.minimum_height
                        MDLabel:
                            text: f"Renda Fixa ({root.rf_perc}%):"
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            size_hint_y: None
                            height: self.texture_size[1]
                        MDLabel:
                            text: f"R$ {root.rf_val:.2f}"
                            font_style: "Body2"
                            theme_text_color: "Custom"
                            text_color: 0.8, 0.8, 0.8, 1 
                            halign: "right"
                            size_hint_y: None
                            height: self.texture_size[1]
                            
                    MDBoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: self.minimum_height
                        MDLabel:
                            text: f"Renda Variável ({root.rv_perc}%):"
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            size_hint_y: None
                            height: self.texture_size[1]
                        MDLabel:
                            text: f"R$ {root.rv_val:.2f}"
                            font_style: "Body2"
                            theme_text_color: "Custom"
                            text_color: 0.8, 0.8, 0.8, 1 
                            halign: "right"
                            size_hint_y: None
                            height: self.texture_size[1]

                    MDSeparator:
                        color: 0.4, 0.4, 0.4, 1

                    MDBoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: self.minimum_height
                        MDLabel:
                            text: "RETORNO ESPERADO:"
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            size_hint_y: None
                            height: self.texture_size[1]
                        MDLabel:
                            text: f"R$ {root.retorno_calc:.2f}"
                            font_style: "H6"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.4, 0.8, 0.4, 1 # Verde
                            halign: "right"
                            size_hint_y: None
                            height: self.texture_size[1]

                    MDBoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: self.minimum_height
                        MDLabel:
                            text: "Risco Sistêmico:"
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            size_hint_y: None
                            height: self.texture_size[1]
                        MDLabel:
                            text: root.risco_texto
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: root.cor_risco 
                            halign: "right"
                            size_hint_y: None
                            height: self.texture_size[1]

                # ==========================================
                # O SLIDER DE ALOCAÇÃO
                # ==========================================
                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "70dp"
                    MDLabel:
                        text: "Deslize para aumentar a % em Renda Variável"
                        font_style: "Caption"
                        bold: True
                        halign: "center"
                    MDSlider:
                        min: 0
                        max: 100
                        step: 5
                        value: root.rv_perc
                        on_value: root.atualizar_alocacao(self.value)

                # ==========================================
                # ÁREA DA MISSÃO
                # ==========================================
                MDCard:
                    orientation: 'vertical'
                    padding: "16dp"
                    spacing: "16dp"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [10]
                    md_bg_color: 1, 0.95, 0.8, 1 

                    MDLabel:
                        text: root.titulo_missao
                        font_style: "Subtitle2"
                        bold: True
                        theme_text_color: "Error"
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        text: root.texto_missao
                        markup: True
                        font_style: "Caption"
                        theme_text_color: "Primary"
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None

                    MDBoxLayout:
                        id: action_container
                        orientation: 'vertical'
                        spacing: "8dp"
                        size_hint_y: None
                        height: self.minimum_height