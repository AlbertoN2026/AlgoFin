<JurosCompostos3Screen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: 0.95, 0.95, 0.97, 1

        MDTopAppBar:
            title: "1. A Força do Expoente"
            elevation: 2
            left_action_items: [["arrow-left", lambda x: root.voltar()]]

        ScrollView:
            MDBoxLayout:
                orientation: 'vertical'
                padding: "16dp"
                spacing: "24dp"
                adaptive_height: True

                MDCard:
                    orientation: 'vertical'
                    padding: "20dp"
                    spacing: "12dp"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [15]
                    md_bg_color: 1, 1, 1, 1
                    elevation: 2

                    MDLabel:
                        text: "Análise do Tempo como Variável Exponencial"
                        font_style: "H6"
                        bold: True
                        theme_text_color: "Primary"
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        text: "Na fórmula matemática M = C(1+i)ⁿ, a variável 'n' (Tempo) é a única que atua como EXPOENTE. Isso significa que, a longo prazo, o Tempo tem um poder de multiplicação muito maior do que o Capital (C) ou a Taxa (i)."
                        font_style: "Body2"
                        theme_text_color: "Secondary"
                        size_hint_y: None
                        height: self.texture_size[1]

                MDCard:
                    orientation: 'vertical'
                    padding: "20dp"
                    spacing: "16dp"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [15]
                    md_bg_color: 0.15, 0.15, 0.2, 1 

                    MDLabel:
                        text: "CÁLCULO ALGORÍTMICO"
                        font_style: "Overline"
                        theme_text_color: "Custom"
                        text_color: 0.7, 0.7, 0.7, 1
                        halign: "center"
                        size_hint_y: None
                        height: self.texture_size[1]
                        
                    MDBoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: self.minimum_height
                        MDLabel:
                            text: "Total Investido (Sem Juros):"
                            font_style: "Subtitle2"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            size_hint_y: None
                            height: self.texture_size[1]
                        MDLabel:
                            text: f"R$ {root.total_investido:.2f}"
                            font_style: "Body1"
                            theme_text_color: "Custom"
                            text_color: 0.8, 0.8, 0.8, 1 
                            halign: "right"
                            size_hint_y: None
                            height: self.texture_size[1]

                    MDSeparator:
                        color: 0.4, 0.4, 0.4, 1

                    MDBoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: self.minimum_height
                        MDLabel:
                            text: "MONTANTE FINAL:"
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            size_hint_y: None
                            height: self.texture_size[1]
                        MDLabel:
                            text: f"R$ {root.montante_final:.2f}"
                            font_style: "H5"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.4, 0.8, 0.4, 1 
                            halign: "right"
                            size_hint_y: None
                            height: self.texture_size[1]

                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "60dp"
                    MDLabel:
                        text: f"Aporte Mensal: R$ {root.aporte_val:.2f}"
                        font_style: "Caption"
                        bold: True
                    MDSlider:
                        min: 100
                        max: 2000
                        step: 100
                        value: root.aporte_val
                        on_value: root.atualizar_aporte(self.value)

                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "60dp"
                    MDLabel:
                        text: f"Taxa de Juros: {root.taxa_val}% ao mês"
                        font_style: "Caption"
                        bold: True
                    MDSlider:
                        min: 0.5
                        max: 2.0
                        step: 0.1
                        value: root.taxa_val
                        on_value: root.atualizar_taxa(self.value)

                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "60dp"
                    MDLabel:
                        text: f"Prazo (Anos): {root.anos_val} anos"
                        font_style: "Caption"
                        bold: True
                    MDSlider:
                        min: 1
                        max: 40
                        step: 1
                        value: root.anos_val
                        on_value: root.atualizar_anos(self.value)

                MDCard:
                    orientation: 'vertical'
                    padding: "16dp"
                    spacing: "16dp"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [10]
                    md_bg_color: 1, 0.95, 0.8, 1 

                    MDLabel:
                        text: root.titulo_missao
                        font_style: "Subtitle2"
                        bold: True
                        theme_text_color: "Error"
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        text: root.texto_missao
                        markup: True
                        font_style: "Caption"
                        theme_text_color: "Primary"
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None

                    MDBoxLayout:
                        id: action_container
                        orientation: 'vertical'
                        spacing: "8dp"
                        size_hint_y: None
                        height: self.minimum_height