<AmortizacaoScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: 0.95, 0.95, 0.97, 1

        MDTopAppBar:
            title: "2. Amortização (SAC e Price)"
            elevation: 2
            left_action_items: [["arrow-left", lambda x: root.voltar()]]

        ScrollView:
            MDBoxLayout:
                orientation: 'vertical'
                padding: "16dp"
                spacing: "24dp"
                adaptive_height: True

                # ==========================================
                # O TUTOR IA (ANIMAÇÃO)
                # ==========================================
                MDBoxLayout:
                    id: balao_robo
                    opacity: 0
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "12dp"

                    MDIcon:
                        icon: "home-city-outline"
                        font_size: "54sp"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        pos_hint: {"top": 1}

                    MDCard:
                        id: card_fala
                        orientation: 'vertical'
                        md_bg_color: 0.85, 0.92, 0.98, 1
                        radius: [0, 20, 20, 20]
                        padding: "16dp"
                        spacing: "8dp"
                        size_hint_y: None
                        height: self.minimum_height
                        elevation: 1

                        MDLabel:
                            text: "O Sonho da Casa Própria!"
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Primary"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDLabel:
                            text: "No Brasil, existem dois sistemas para financiar imóveis. SAC (Amortização Constante) e Price (Parcelas Fixas). Teste os sliders e compare a diferença brutal de juros entre os dois!"
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                # ==========================================
                # DASHBOARD COMPARATIVO (LADO A LADO)
                # ==========================================
                MDBoxLayout:
                    orientation: 'horizontal'
                    spacing: "10dp"
                    size_hint_y: None
                    height: self.minimum_height
                    
                    # Coluna SAC
                    MDCard:
                        orientation: 'vertical'
                        padding: "12dp"
                        spacing: "8dp"
                        size_hint_y: None
                        height: self.minimum_height
                        radius: [15]
                        md_bg_color: 0.15, 0.15, 0.2, 1 
                        
                        MDLabel:
                            text: "TABELA SAC"
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            halign: "center"
                            size_hint_y: None
                            height: self.texture_size[1]
                            
                        MDLabel:
                            text: f"1ª Parcela: R$ {root.sac_primeira:.2f}"
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: 0.8, 0.8, 0.8, 1
                            size_hint_y: None
                            height: self.texture_size[1]
                            
                        MDLabel:
                            text: f"Última: R$ {root.sac_ultima:.2f}"
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: 0.8, 0.8, 0.8, 1
                            size_hint_y: None
                            height: self.texture_size[1]
                            
                        MDSeparator:
                            color: 0.4, 0.4, 0.4, 1
                            
                        MDLabel:
                            text: "Juros Totais:"
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: 0.9, 0.3, 0.3, 1
                            size_hint_y: None
                            height: self.texture_size[1]
                            
                        MDLabel:
                            text: f"R$ {root.sac_juros_total:.2f}"
                            font_style: "Body2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.9, 0.3, 0.3, 1 
                            size_hint_y: None
                            height: self.texture_size[1]

                    # Coluna PRICE
                    MDCard:
                        orientation: 'vertical'
                        padding: "12dp"
                        spacing: "8dp"
                        size_hint_y: None
                        height: self.minimum_height
                        radius: [15]
                        md_bg_color: 0.15, 0.15, 0.2, 1 
                        
                        MDLabel:
                            text: "TABELA PRICE"
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            halign: "center"
                            size_hint_y: None
                            height: self.texture_size[1]
                            
                        MDLabel:
                            text: f"1ª Parcela: R$ {root.price_primeira:.2f}"
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: 0.8, 0.8, 0.8, 1
                            size_hint_y: None
                            height: self.texture_size[1]
                            
                        MDLabel:
                            text: f"Última: R$ {root.price_ultima:.2f}"
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: 0.8, 0.8, 0.8, 1
                            size_hint_y: None
                            height: self.texture_size[1]
                            
                        MDSeparator:
                            color: 0.4, 0.4, 0.4, 1
                            
                        MDLabel:
                            text: "Juros Totais:"
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: 0.9, 0.3, 0.3, 1
                            size_hint_y: None
                            height: self.texture_size[1]
                            
                        MDLabel:
                            text: f"R$ {root.price_juros_total:.2f}"
                            font_style: "Body2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.9, 0.3, 0.3, 1 
                            size_hint_y: None
                            height: self.texture_size[1]

                # ==========================================
                # OS SLIDERS
                # ==========================================
                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "60dp"
                    MDLabel:
                        text: f"Valor Financiado: R$ {root.financiamento_val:.2f}"
                        font_style: "Caption"
                        bold: True
                    MDSlider:
                        min: 50000
                        max: 500000
                        step: 10000
                        value: root.financiamento_val
                        on_value: root.atualizar_financiamento(self.value)

                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "60dp"
                    MDLabel:
                        text: f"Taxa de Juros: {root.taxa_val}% ao mês"
                        font_style: "Caption"
                        bold: True
                    MDSlider:
                        min: 0.5
                        max: 2.0
                        step: 0.1
                        value: root.taxa_val
                        on_value: root.atualizar_taxa(self.value)

                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "60dp"
                    MDLabel:
                        text: f"Prazo (Meses): {root.prazo_val}x"
                        font_style: "Caption"
                        bold: True
                    MDSlider:
                        min: 60
                        max: 360
                        step: 60
                        value: root.prazo_val
                        on_value: root.atualizar_prazo(self.value)

                # ==========================================
                # ÁREA DA MISSÃO
                # ==========================================
                MDCard:
                    orientation: 'vertical'
                    padding: "16dp"
                    spacing: "16dp"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [10]
                    md_bg_color: 1, 0.95, 0.8, 1 

                    MDLabel:
                        text: root.titulo_missao
                        font_style: "Subtitle2"
                        bold: True
                        theme_text_color: "Error"
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        text: root.texto_missao
                        markup: True
                        font_style: "Caption"
                        theme_text_color: "Primary"
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None

                    MDBoxLayout:
                        id: action_container
                        orientation: 'vertical'
                        spacing: "8dp"
                        size_hint_y: None
                        height: self.minimum_height