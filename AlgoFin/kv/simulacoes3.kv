<Simulacoes3Screen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: 0.95, 0.95, 0.97, 1

        MDTopAppBar:
            title: "8. Simulações Financeiras"
            elevation: 2
            left_action_items: [["arrow-left", lambda x: root.voltar()]]

        ScrollView:
            MDBoxLayout:
                orientation: 'vertical'
                padding: "16dp"
                spacing: "24dp"
                adaptive_height: True

                # ==========================================
                # BLOCO 1: FUNDAMENTOS TEÓRICOS
                # ==========================================
                MDCard:
                    orientation: 'vertical'
                    padding: "20dp"
                    spacing: "12dp"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [15]
                    md_bg_color: 1, 1, 1, 1
                    elevation: 2

                    MDLabel:
                        text: "A Regra dos 4% (Safe Withdrawal Rate)"
                        font_style: "H6"
                        bold: True
                        theme_text_color: "Primary"
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        text: "Para saber se você pode se aposentar, os matemáticos criaram uma regra: se você sacar apenas 4% do seu patrimônio por ano, o rendimento dos investimentos repõe o que você gastou, e o dinheiro dura para sempre (ou pelo menos 30 anos)."
                        font_style: "Body2"
                        theme_text_color: "Secondary"
                        size_hint_y: None
                        height: self.texture_size[1]

                # ==========================================
                # O TUTOR IA
                # ==========================================
                MDBoxLayout:
                    id: balao_robo
                    opacity: 0
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "12dp"

                    MDIcon:
                        icon: "beach"
                        font_size: "54sp"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        pos_hint: {"top": 1}

                    MDCard:
                        id: card_fala
                        orientation: 'vertical'
                        md_bg_color: 0.85, 0.92, 0.98, 1
                        radius: [0, 20, 20, 20]
                        padding: "16dp"
                        spacing: "8dp"
                        size_hint_y: None
                        height: self.minimum_height
                        elevation: 1

                        MDLabel:
                            text: "Simulador de Independência!"
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Primary"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDLabel:
                            text: "Vamos simular a sua aposentadoria a partir dos 60 anos! Ajuste o seu patrimônio, o quanto você quer gastar por mês, e rode a simulação para descobrir se o seu dinheiro sobrevive até os 100 anos."
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                # ==========================================
                # DASHBOARD DA SIMULAÇÃO (STATUS DA VIDA)
                # ==========================================
                MDCard:
                    orientation: 'vertical'
                    padding: "20dp"
                    spacing: "16dp"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [15]
                    md_bg_color: 0.15, 0.15, 0.2, 1 

                    MDLabel:
                        text: "RESULTADO DA SIMULAÇÃO (60 a 100 anos)"
                        font_style: "Overline"
                        theme_text_color: "Custom"
                        text_color: 0.7, 0.7, 0.7, 1
                        halign: "center"
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDSeparator:
                        color: 0.4, 0.4, 0.4, 1

                    MDBoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: self.minimum_height
                        MDLabel:
                            text: "STATUS:"
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            size_hint_y: None
                            height: self.texture_size[1]
                        MDLabel:
                            text: root.status_texto
                            font_style: "H6"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: root.cor_status 
                            halign: "right"
                            size_hint_y: None
                            height: self.texture_size[1]

                    MDLabel:
                        text: root.detalhe_texto
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: 0.8, 0.8, 0.8, 1
                        halign: "center"
                        size_hint_y: None
                        height: self.texture_size[1]

                # ==========================================
                # OS SLIDERS
                # ==========================================
                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "60dp"
                    MDLabel:
                        text: f"Patrimônio Acumulado: R$ {root.patrimonio_val:,.2f}".replace(",", "X").replace(".", ",").replace("X", ".")
                        font_style: "Caption"
                        bold: True
                    MDSlider:
                        min: 100000
                        max: 3000000
                        step: 100000
                        value: root.patrimonio_val
                        on_value: root.atualizar_patrimonio(self.value)

                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "60dp"
                    MDLabel:
                        text: f"Gasto Mensal Desejado: R$ {root.gasto_val:,.2f}".replace(",", "X").replace(".", ",").replace("X", ".")
                        font_style: "Caption"
                        bold: True
                    MDSlider:
                        min: 2000
                        max: 20000
                        step: 500
                        value: root.gasto_val
                        on_value: root.atualizar_gasto(self.value)

                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "60dp"
                    MDLabel:
                        text: f"Rendimento Real Anual (Acima da Inflação): {root.rendimento_val}%"
                        font_style: "Caption"
                        bold: True
                    MDSlider:
                        min: 2.0
                        max: 8.0
                        step: 0.5
                        value: root.rendimento_val
                        on_value: root.atualizar_rendimento(self.value)

                # ==========================================
                # ÁREA DA MISSÃO
                # ==========================================
                MDCard:
                    orientation: 'vertical'
                    padding: "16dp"
                    spacing: "16dp"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [10]
                    md_bg_color: 1, 0.95, 0.8, 1 

                    MDLabel:
                        text: root.titulo_missao
                        font_style: "Subtitle2"
                        bold: True
                        theme_text_color: "Error"
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        text: root.texto_missao
                        markup: True
                        font_style: "Caption"
                        theme_text_color: "Primary"
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None

                    MDBoxLayout:
                        id: action_container
                        orientation: 'vertical'
                        spacing: "8dp"
                        size_hint_y: None
                        height: self.minimum_height