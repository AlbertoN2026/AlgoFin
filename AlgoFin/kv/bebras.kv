<BebrasScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: 0.95, 0.95, 0.97, 1

        MDTopAppBar:
            title: "9. Desafios Bebras (Lógica)"   # <-- TÍTULO CORRIGIDO AQUI
            elevation: 2
            left_action_items: [["arrow-left", lambda x: root.voltar()]]

        ScrollView:
            MDBoxLayout:
                orientation: 'vertical'
                padding: "16dp"
                spacing: "24dp"
                adaptive_height: True

                # ==========================================
                # O TUTOR IA E O PROGRESSO
                # ==========================================
                MDBoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "12dp"

                    MDIcon:
                        icon: "trophy-outline"
                        font_size: "54sp"
                        theme_text_color: "Custom"
                        text_color: 0.8, 0.6, 0.1, 1 # Dourado
                        pos_hint: {"top": 1}

                    MDCard:
                        orientation: 'vertical'
                        md_bg_color: 0.85, 0.92, 0.98, 1
                        radius: [0, 20, 20, 20]
                        padding: "16dp"
                        spacing: "8dp"
                        size_hint_y: None
                        height: self.minimum_height
                        elevation: 1

                        MDLabel:
                            text: f"Questão {root.questao_atual_idx + 1} de 5"
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Primary"
                            size_hint_y: None
                            height: self.texture_size[1]
                            text_size: self.width, None

                        MDLabel:
                            text: "Leia o cenário atentamente. A lógica estruturada é a sua única ferramenta de resolução."
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]
                            text_size: self.width, None

                # ==========================================
                # O ENUNCIADO DO DESAFIO
                # ==========================================
                MDLabel:
                    text: root.titulo_fase
                    font_style: "H6"
                    bold: True
                    theme_text_color: "Primary"
                    halign: "center"

                MDCard:
                    orientation: 'vertical'
                    padding: "20dp"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [15]
                    elevation: 2
                    md_bg_color: 1, 1, 1, 1

                    MDLabel:
                        text: root.enunciado_texto
                        markup: True
                        font_style: "Body2"
                        theme_text_color: "Primary"
                        halign: "justify"
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None

                # ==========================================
                # BOTÕES DE RESPOSTA (A, B, C, D)
                # ==========================================
                MDBoxLayout:
                    id: container_opcoes
                    orientation: 'vertical'
                    spacing: "12dp"
                    adaptive_height: True