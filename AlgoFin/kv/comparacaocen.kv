<ComparacaoCenScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: 0.95, 0.95, 0.97, 1

        MDTopAppBar:
            title: "6. Comparação de Cenários"
            elevation: 2
            left_action_items: [["arrow-left", lambda x: root.voltar()]]

        ScrollView:
            MDBoxLayout:
                orientation: 'vertical'
                padding: "16dp"
                spacing: "24dp"
                adaptive_height: True

                # ==========================================
                # BLOCO 1: FUNDAMENTOS TEÓRICOS
                # ==========================================
                MDCard:
                    orientation: 'vertical'
                    padding: "20dp"
                    spacing: "12dp"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [15]
                    md_bg_color: 1, 1, 1, 1
                    elevation: 2

                    MDLabel:
                        text: "O Grande Duelo Matemático"
                        font_style: "H6"
                        bold: True
                        theme_text_color: "Primary"

                    MDLabel:
                        text: "Em avaliações e na vida real, você sempre precisará comparar cenários. Aqui, colocaremos a Matemática Linear (Juros Simples) para competir lado a lado com a Matemática Exponencial (Juros Compostos) usando o mesmo capital e a mesma taxa."
                        font_style: "Body2"
                        theme_text_color: "Secondary"
                        size_hint_y: None
                        height: self.texture_size[1]

                # ==========================================
                # O TUTOR IA (ANIMAÇÃO)
                # ==========================================
                MDBoxLayout:
                    id: balao_robo
                    opacity: 0
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "12dp"

                    MDIcon:
                        icon: "robot-excited-outline"
                        font_size: "54sp"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        pos_hint: {"top": 1}

                    MDCard:
                        id: card_fala
                        orientation: 'vertical'
                        md_bg_color: 0.85, 0.92, 0.98, 1
                        radius: [0, 20, 20, 20]
                        padding: "16dp"
                        spacing: "8dp"
                        size_hint_y: None
                        height: self.minimum_height
                        elevation: 1

                        MDLabel:
                            text: "Laboratório de Provas Ativado!"
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Primary"
                            size_hint_y: None
                            height: self.texture_size[1]
                        MDLabel:
                            text: "Altere o TEMPO no slider lá embaixo e observe com muita atenção o que acontece nos primeiros meses do duelo. Há um segredo aí que costuma cair muito em olimpíadas!"
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                # ==========================================
                # BLOCO 2: DASHBOARD COMPARATIVO
                # ==========================================
                MDBoxLayout:
                    orientation: 'horizontal'
                    spacing: "10dp"
                    size_hint_y: None
                    height: self.minimum_height
                    
                    # Coluna Juros Simples
                    MDCard:
                        orientation: 'vertical'
                        padding: "16dp"
                        spacing: "8dp"
                        size_hint_y: None
                        height: self.minimum_height
                        radius: [15]
                        md_bg_color: 0.15, 0.15, 0.2, 1 
                        
                        MDLabel:
                            text: "CENÁRIO A"
                            font_style: "Overline"
                            theme_text_color: "Custom"
                            text_color: 0.7, 0.7, 0.7, 1
                            halign: "center"
                            size_hint_y: None
                            height: self.texture_size[1]
                        
                        MDLabel:
                            text: "Juros Simples"
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            halign: "center"
                            size_hint_y: None
                            height: self.texture_size[1]
                            
                        MDSeparator:
                            color: 0.4, 0.4, 0.4, 1
                            
                        MDLabel:
                            text: f"R$ {root.montante_simples:.2f}"
                            font_style: "H6"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.8, 0.8, 0.3, 1 # Amarelo
                            halign: "center"
                            size_hint_y: None
                            height: self.texture_size[1]

                    # Coluna Juros Compostos
                    MDCard:
                        orientation: 'vertical'
                        padding: "16dp"
                        spacing: "8dp"
                        size_hint_y: None
                        height: self.minimum_height
                        radius: [15]
                        md_bg_color: 0.15, 0.15, 0.2, 1 
                        
                        MDLabel:
                            text: "CENÁRIO B"
                            font_style: "Overline"
                            theme_text_color: "Custom"
                            text_color: 0.7, 0.7, 0.7, 1
                            halign: "center"
                            size_hint_y: None
                            height: self.texture_size[1]
                        
                        MDLabel:
                            text: "Juros Compostos"
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            halign: "center"
                            size_hint_y: None
                            height: self.texture_size[1]
                            
                        MDSeparator:
                            color: 0.4, 0.4, 0.4, 1
                            
                        MDLabel:
                            text: f"R$ {root.montante_composto:.2f}"
                            font_style: "H6"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.3, 0.8, 0.3, 1 # Verde vivo
                            halign: "center"
                            size_hint_y: None
                            height: self.texture_size[1]

                MDLabel:
                    text: f"Diferença a favor do Cenário B: R$ {root.diferenca_cenarios:.2f}"
                    font_style: "Caption"
                    bold: True
                    halign: "center"
                    size_hint_y: None
                    height: self.texture_size[1]

                # ==========================================
                # OS SLIDERS DE CONTROLE ÚNICO 
                # ==========================================
                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "60dp"
                    MDLabel:
                        text: f"Capital (Igual para ambos): R$ {root.capital_val:.2f}"
                        font_style: "Caption"
                        bold: True
                    MDSlider:
                        min: 100
                        max: 2000
                        step: 100
                        value: root.capital_val
                        on_value: root.atualizar_capital(self.value)

                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "60dp"
                    MDLabel:
                        text: f"Taxa (Igual para ambos): {root.taxa_val}% ao mês"
                        font_style: "Caption"
                        bold: True
                    MDSlider:
                        min: 1
                        max: 15
                        step: 1
                        value: root.taxa_val
                        on_value: root.atualizar_taxa(self.value)
                        
                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "60dp"
                    MDLabel:
                        text: f"Tempo de Aplicação: {root.tempo_val} meses"
                        font_style: "Caption"
                        bold: True
                    MDSlider:
                        min: 1
                        max: 48
                        step: 1
                        value: root.tempo_val
                        on_value: root.atualizar_tempo(self.value)

                # ==========================================
                # BLOCO 3: MISSÃO E OLIMPÍADA
                # ==========================================
                MDCard:
                    orientation: 'vertical'
                    padding: "16dp"
                    spacing: "16dp"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [10]
                    md_bg_color: 1, 0.95, 0.8, 1 

                    MDLabel:
                        text: root.titulo_missao
                        font_style: "Subtitle2"
                        bold: True
                        theme_text_color: "Error"

                    MDLabel:
                        text: root.texto_missao
                        markup: True
                        font_style: "Caption"
                        theme_text_color: "Primary"
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None

                    MDBoxLayout:
                        id: action_container
                        orientation: 'vertical'
                        spacing: "8dp"
                        size_hint_y: None
                        height: self.minimum_height