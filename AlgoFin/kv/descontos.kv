<DescontosScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: 0.95, 0.95, 0.97, 1

        MDTopAppBar:
            title: "2. Modelagem: Descontos"
            elevation: 2
            left_action_items: [["arrow-left", lambda x: root.voltar()]]

        ScrollView:
            MDBoxLayout:
                orientation: 'vertical'
                padding: "16dp"
                spacing: "24dp"
                adaptive_height: True

                # ==========================================
                # BLOCO 1: FUNDAMENTOS TEÓRICOS
                # ==========================================
                MDCard:
                    orientation: 'vertical'
                    padding: "20dp"
                    spacing: "12dp"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [15]
                    md_bg_color: 1, 1, 1, 1
                    elevation: 2

                    MDLabel:
                        text: "A Matemática do Consumo"
                        font_style: "H6"
                        bold: True
                        theme_text_color: "Primary"

                    MDLabel:
                        text: "Um desconto é uma redução aplicada sobre o preço original de um produto ou serviço. Na modelagem algébrica, dar um desconto de 20% é o mesmo que multiplicar o valor original por 0,80 (ou seja, você paga 80% do produto)."
                        font_style: "Body2"
                        theme_text_color: "Secondary"
                        size_hint_y: None
                        height: self.texture_size[1]

                # ==========================================
                # O TUTOR IA (ANIMAÇÃO)
                # ==========================================
                MDBoxLayout:
                    id: balao_robo
                    opacity: 0
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "12dp"

                    MDIcon:
                        icon: "robot-excited-outline"
                        font_size: "54sp"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        pos_hint: {"top": 1}

                    MDCard:
                        id: card_fala
                        orientation: 'vertical'
                        md_bg_color: 0.85, 0.92, 0.98, 1
                        radius: [0, 20, 20, 20]
                        padding: "16dp"
                        spacing: "8dp"
                        size_hint_y: None
                        height: self.minimum_height
                        elevation: 1

                        MDLabel:
                            text: "Detetor de Promoções!"
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Primary"
                            size_hint_y: None
                            height: self.texture_size[1]
                        MDLabel:
                            text: "Bem-vindo ao Simulador de Vitrine. Ajuste o preço da etiqueta e a taxa de desconto oferecida pela loja para ver o impacto real antes de comprar."
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                # ==========================================
                # BLOCO 2: DASHBOARD DE COMPRAS E SLIDERS
                # ==========================================
                MDCard:
                    orientation: 'vertical'
                    padding: "16dp"
                    spacing: "8dp"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [15]
                    md_bg_color: 0.15, 0.15, 0.2, 1 

                    MDLabel:
                        text: "CUPOM FISCAL SIMULADO"
                        font_style: "Overline"
                        theme_text_color: "Custom"
                        text_color: 0.7, 0.7, 0.7, 1
                        halign: "center"

                    MDBoxLayout:
                        orientation: 'horizontal'
                        MDLabel:
                            text: "Valor Poupado:"
                            font_style: "Subtitle2"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                        MDLabel:
                            text: f"- R$ {root.valor_desconto_calc:.2f}"
                            font_style: "H6"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.9, 0.3, 0.3, 1 # Vermelho para o desconto
                            halign: "right"

                    MDSeparator:
                        color: 0.4, 0.4, 0.4, 1

                    MDBoxLayout:
                        orientation: 'horizontal'
                        MDLabel:
                            text: "PREÇO FINAL:"
                            font_style: "Subtitle2"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                        MDLabel:
                            text: f"R$ {root.preco_final_calc:.2f}"
                            font_style: "H6"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.4, 0.8, 0.4, 1 # Verde para o valor a pagar
                            halign: "right"

                # Sliders Interativos
                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "60dp"
                    MDLabel:
                        text: f"Preço de Etiqueta: R$ {root.preco_val:.2f}"
                        font_style: "Caption"
                        bold: True
                    MDSlider:
                        min: 50
                        max: 1000
                        step: 50
                        value: root.preco_val
                        on_value: root.atualizar_preco(self.value)

                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "60dp"
                    MDLabel:
                        text: f"Desconto Aplicado: {root.desconto_val}%"
                        font_style: "Caption"
                        bold: True
                    MDSlider:
                        min: 0
                        max: 80
                        step: 5
                        value: root.desconto_val
                        on_value: root.atualizar_desconto(self.value)

                # ==========================================
                # BLOCO 3: MISSÃO DE MODELAGEM DINÂMICA
                # ==========================================
                MDCard:
                    orientation: 'vertical'
                    padding: "16dp"
                    spacing: "16dp"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [10]
                    md_bg_color: 1, 0.95, 0.8, 1 

                    MDLabel:
                        text: root.titulo_missao
                        font_style: "Subtitle2"
                        bold: True
                        theme_text_color: "Error"

                    MDLabel:
                        text: root.texto_missao
                        markup: True
                        font_style: "Caption"
                        theme_text_color: "Primary"
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None

                    MDBoxLayout:
                        id: action_container
                        orientation: 'vertical'
                        spacing: "8dp"
                        size_hint_y: None
                        height: self.minimum_height